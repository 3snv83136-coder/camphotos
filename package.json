{
  "name": "camphotos",
  "version": "1.0.3",
  "description": "Visionneuse vidéo d'inspection avec capture photo",
  "main": "electron/main.js",
  "author": "CAMPHOTOS",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac dmg zip && node scripts/post-dist-mac.js",
    "build:web": "echo 'CAMPHOTOS static — output public/'"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.camphotos.app",
    "productName": "CAMPHOTOS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**/*"
    ],
    "asarUnpack": [
      "**/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "CAMPHOTOS",
      "format": "UDZO",
      "writeUpdateInfo": false,
      "contents": [
        {
          "x": 140,
          "y": 160,
          "type": "file"
        },
        {
          "x": 420,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 280,
          "y": 340,
          "type": "file",
          "path": "build/Installer.command"
        }
      ]
    },
    "afterPack": "scripts/after-pack.js"
  }
}
