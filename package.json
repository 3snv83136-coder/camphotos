{
  "name": "camphotos",
  "version": "1.0.0",
  "description": "Visionneuse vidéo d'inspection avec capture photo",
  "main": "electron/main.js",
  "author": "CAMPHOTOS",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac dir zip",
    "build:web": "echo 'CAMPHOTOS static — output public/'"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.camphotos.app",
    "productName": "CAMPHOTOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": ["dir", "zip"],
      "identity": null
    }
  }
}
